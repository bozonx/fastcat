{
  "name": "fastcat",
  "version": "0.5.2",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/bozonx/fastcat.git"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:lib": "vite build -c vite.config.lib.ts",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "check": "pnpm check:ui && pnpm check:native",
    "check:ui": "pnpm i18n:check && pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:integration:web && pnpm test:parity:web",
    "check:native": "pnpm clippy && pnpm fmt:check && pnpm test:native",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "i18n:check": "node scripts/check-i18n-locales.mjs",
    "typecheck": "nuxi typecheck",
    "test:unit": "vitest run test/unit test/components",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:docker": "bash scripts/e2e-docker.sh",
    "test:e2e:docker:smoke": "bash scripts/e2e-docker.sh -- test/e2e/smoke",
    "test:e2e:docker:shell": "docker compose --profile e2e run --rm playwright sh -c 'corepack enable && bash'",
    "test:e2e:docker:clean": "docker compose --profile e2e down -v",
    "test:e2e:tauri": "bash scripts/tauri-e2e.sh",
    "test:e2e:tauri:build": "FORCE_BUILD=1 bash scripts/tauri-e2e.sh",
    "tauri:e2e:build": "dotenv -e src-tauri/.env -- tauri build --no-bundle",
    "test:watch": "vitest",
    "test:integration": "pnpm test:integration:web && pnpm test:integration:native",
    "test:integration:web": "vitest run test/integration test/parity-helpers",
    "test:integration:native": "cargo test --manifest-path src-tauri/Cargo.toml --features test-support --test media_probe --test audio_offline --test audio_engine_realtime --test timeline_export --test engine_parity",
    "test:unit:coverage": "vitest run --coverage test/unit test/components",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --features test-support",
    "test:parity:web": "playwright test --grep @parity",
    "test:parity:native": "cargo test --manifest-path src-tauri/Cargo.toml --features test-support --test engine_parity -- --nocapture",
    "test:parity": "pnpm test:parity:web && pnpm test:parity:native",
    "test:parity:gen-golden": "tsx scripts/gen-golden.ts --both",
    "test:parity:gen-golden:web": "tsx scripts/gen-golden.ts --web",
    "test:parity:import-native": "tsx scripts/import-native-golden.ts",
    "tauri": "dotenv -e src-tauri/.env -- tauri",
    "tauri:dev": "dotenv -e src-tauri/.env -- tauri dev",
    "tauri:build": "dotenv -e src-tauri/.env -- tauri build",
    "start": "nuxt preview",
    "prod": "pnpm build && pnpm start",
    "build:preview": "pnpm build && pnpm preview"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@nuxt/ui": "^4.8.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@vueuse/core": "^14.3.0",
    "exifr": "^7.1.3",
    "js-yaml": "^4.1.1",
    "mediabunny": "^1.45.4",
    "nuxt": "^4.4.6",
    "p-queue": "^9.3.0",
    "pinia": "^3.0.4",
    "pixi.js": "^8.18.1",
    "splitpanes": "^4.1.2",
    "tauri-plugin-fs-stream-api": "2.0.0",
    "vue": "^3.5.35",
    "vue-draggable-plus": "^0.6.1",
    "wavesurfer.js": "^7.12.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.110",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/icon": "^2.2.2",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/device": "^4.0.0",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/splitpanes": "^2.2.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "@wdio/cli": "^9.29.0",
    "@wdio/local-runner": "^9.29.0",
    "@wdio/mocha-framework": "^9.29.0",
    "@wdio/spec-reporter": "^9.29.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "vue-i18n": "^11.4.4"
  }
}
