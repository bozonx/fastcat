{
  "name": "fastcat",
  "version": "0.5.2",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/bozonx/fastcat.git"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:lib": "vite build -c vite.config.lib.ts",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "node scripts/vendor-fonts.mjs && nuxt prepare",
    "fonts:vendor": "node scripts/vendor-fonts.mjs",
    "update:tauri": "pnpm add -D @tauri-apps/cli@latest @tauri-apps/api@latest && pnpm add @tauri-apps/plugin-dialog@latest @tauri-apps/plugin-fs@latest @tauri-apps/plugin-os@latest",
    "check": "pnpm check:ui && pnpm check:native && pnpm test:e2e && pnpm test:e2e:tauri",
    "check:ui": "pnpm check:static && pnpm test:unit && pnpm test:integration:web && pnpm test:golden:web",
    "check:native": "pnpm clippy && pnpm fmt:check && pnpm test:native",
    "check:static": "pnpm i18n:check && pnpm typecheck && pnpm lint",
    "check:fast": "pnpm check:static && pnpm test:unit && pnpm test:integration:web",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "i18n:check": "node scripts/check-i18n-locales.mjs",
    "typecheck": "nuxi typecheck",
    "test": "node scripts/clean-test-files.mjs vitest && vitest run",
    "test:files:clean": "node scripts/clean-test-files.mjs",
    "test:unit": "node scripts/clean-test-files.mjs vitest && vitest run test/unit test/components",
    "test:unit:coverage": "node scripts/clean-test-files.mjs vitest && vitest run --coverage test/unit test/components",
    "test:watch": "vitest",
    "test:integration": "pnpm test:integration:web && pnpm test:integration:native",
    "test:integration:web": "node scripts/clean-test-files.mjs vitest && vitest run test/integration test/golden-helpers",
    "test:integration:native": "node scripts/clean-test-files.mjs native/tmp && TMPDIR=\"$PWD/test-files/native/tmp\" cargo test --manifest-path src-tauri/Cargo.toml --features test-support --test media_probe --test audio_offline --test audio_engine_realtime --test timeline_export",
    "test:native": "node scripts/clean-test-files.mjs native/tmp && TMPDIR=\"$PWD/test-files/native/tmp\" cargo test --manifest-path src-tauri/Cargo.toml --features test-support",
    "test:golden": "pnpm test:golden:web && pnpm test:golden:native",
    "test:golden:web": "node scripts/run-playwright-with-preview.mjs test --project=golden",
    "test:golden:native": "node scripts/clean-test-files.mjs native/tmp && TMPDIR=\"$PWD/test-files/native/tmp\" cargo test --manifest-path src-tauri/Cargo.toml --features test-support --test engine_parity -- --nocapture",
    "test:golden:gen": "tsx scripts/gen-golden.ts --both",
    "test:golden:gen:web": "tsx scripts/gen-golden.ts --web",
    "test:golden:import-native": "tsx scripts/import-native-golden.ts",
    "test:e2e": "node scripts/run-playwright-with-preview.mjs test --project=smoke --project=e2e --project=firefox-smoke",
    "test:e2e:smoke": "node scripts/run-playwright-with-preview.mjs test --project=smoke --project=firefox-smoke",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:docker": "bash scripts/e2e-docker.sh test:e2e",
    "test:e2e:docker:smoke": "bash scripts/e2e-docker.sh test:e2e:smoke",
    "test:e2e:docker:golden": "bash scripts/e2e-docker.sh test:golden:web",
    "test:e2e:docker:shell": "docker compose --profile e2e run --rm playwright sh -c 'corepack enable && bash'",
    "test:e2e:docker:clean": "docker compose --profile e2e down -v",
    "test:e2e:tauri": "bash scripts/tauri-e2e.sh",
    "test:e2e:report": "playwright show-report \"${PLAYWRIGHT_HTML_REPORT:-test-files/playwright/report}\"",
    "test:e2e:tauri:build": "FORCE_BUILD=1 bash scripts/tauri-e2e.sh",
    "tauri:build:e2e": "dotenv -e src-tauri/.env -- tauri build --no-bundle",
    "tauri": "dotenv -e src-tauri/.env -- tauri",
    "tauri:dev": "dotenv -e src-tauri/.env -- tauri dev",
    "tauri:build": "dotenv -e src-tauri/.env -- tauri build",
    "start": "nuxt preview",
    "prod": "pnpm build && pnpm start",
    "build:preview": "pnpm build && pnpm preview",
    "deploy:cf": "pnpm generate && wrangler deploy",
    "preview:cf": "pnpm generate && wrangler dev"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/fredoka": "^5.2.10",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/rubik": "^5.2.8",
    "@huggingface/transformers": "^4.2.0",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@vueuse/core": "^14.3.0",
    "exifr": "^7.1.3",
    "js-yaml": "^5.2.1",
    "mediabunny": "^1.50.7",
    "nuxt": "^4.4.8",
    "p-queue": "^9.3.1",
    "pinia": "^3.0.4",
    "pixi.js": "^8.19.0",
    "splitpanes": "^4.1.2",
    "tauri-plugin-fs-stream-api": "2.0.3",
    "vue": "^3.5.39",
    "vue-draggable-plus": "^0.6.1",
    "wavesurfer.js": "^7.12.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.116",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/icon": "^2.3.1",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/device": "^4.0.0",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/splitpanes": "^2.2.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.4",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "vue-i18n": "^11.4.6",
    "vue-tsc": "^3.3.7",
    "wrangler": "^4.107.1"
  }
}
