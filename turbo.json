{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "FASTCAT_ENABLE_IN_DEVELOPMENT_FEATURES",
    "FASTCAT_ENABLE_PREMIUM_FEATURES",
    "FASTCAT_DEV_DIR"
  ],
  "globalPassThroughEnv": [
    "CI",
    "GITHUB_*",
    "TAURI_*",
    "PLAYWRIGHT_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", ".nuxt/**", "dist/**", "src/.vitepress/dist/**"]
    },
    "generate": {
      "dependsOn": ["^build"],
      "outputs": [".output/public/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "cache": true
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "cache": true
    },
    "test:integration:web": {
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
