{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", ".nuxt/**", "dist/**", "src/.vitepress/dist/**"]
    },
    "generate": {
      "dependsOn": ["^build"],
      "outputs": [".output/public/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "cache": true
    },
    "test:integration:web": {
      "cache": true
    },
    "check": {
      "dependsOn": ["typecheck", "lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
