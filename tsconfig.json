{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ESNext", "dom", "dom.iterable", "dom.asynciterable", "webworker"],
    "paths": {
      "~/*": ["src/*"],
      "@/*": ["src/*"],
      "~shared": ["shared"],
      "~shared/*": ["shared/*"],
      "~embed": ["packages/embed/src"],
      "~embed/*": ["packages/embed/src/*"]
    }
  }
}
