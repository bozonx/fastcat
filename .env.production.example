# FastCat — Nuxt frontend environment variables
#
# Copy this file to `.env` (root) and adjust as needed.
# These variables are read by nuxt.config.ts at build/dev time.
# Rust backend variables (render timing, probe) go in src-tauri/.env —
# see /src-tauri/.env.example for reference.
# All variables are optional; the app runs fine without any of them.

# Dev Mode (true/false)
NUXT_PUBLIC_DEV_MODE=false

# Application Base URL
NUXT_APP_BASE_URL=/

# BloggerDog instance base URL
NUXT_PUBLIC_BLOGGER_DOG_API_URL=https://api.bloggerdog.pro
NUXT_PUBLIC_BLOGGER_DOG_UI_URL=https://bloggerdog.pro
# Fastcat Account base URL
NUXT_PUBLIC_FASTCAT_ACCOUNT_API_URL=https://user-account.fastcat.video
NUXT_PUBLIC_FASTCAT_ACCOUNT_UI_URL=https://user-account.fastcat.video/ui

# Port to run the application on
PORT=3009

# Dev directory for app config files (only used in dev mode)
FASTCAT_DEV_DIR=./.dev-files

# Controls whether the browser's native context menu (right-click) is blocked.
# Set to "false" to allow the system context menu.
# Default: true
NUXT_PUBLIC_BLOCK_CONTEXT_MENU=true

# Enables functionality that is still in development. Default: false.
FASTCAT_ENABLE_IN_DEVELOPMENT_FEATURES=false

# Enables all premium functionality. Default: false.
FASTCAT_ENABLE_PREMIUM_FEATURES=false
