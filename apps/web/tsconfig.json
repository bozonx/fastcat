{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ESNext", "dom", "dom.iterable", "dom.asynciterable", "webworker"],
    "paths": {
      "~/*": ["src/*"],
      "@/*": ["src/*"],
      "~shared": ["../../packages/shared"],
      "~shared/*": ["../../packages/shared/*"],
      "~embed": ["../../packages/embed/src"],
      "~embed/*": ["../../packages/embed/src/*"]
    }
  }
}
