{
  "name": "@fastcat/web",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "node ../../scripts/static-preview-server.mjs",
    "postinstall": "node ../../scripts/vendor-fonts.mjs && nuxt prepare",
    "fonts:vendor": "node ../../scripts/vendor-fonts.mjs",
    "typecheck": "nuxi typecheck",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "validate": "pnpm check && pnpm test:unit",
    "i18n:check": "node ../../scripts/check-i18n-locales.mjs",
    "test": "node ../../scripts/clean-test-files.mjs vitest && vitest run",
    "test:unit": "node ../../scripts/clean-test-files.mjs vitest && vitest run test/unit test/components",
    "test:unit:coverage": "node ../../scripts/clean-test-files.mjs vitest && vitest run --coverage test/unit test/components",
    "test:watch": "vitest",
    "test:integration:web": "node ../../scripts/clean-test-files.mjs vitest && vitest run test/integration test/golden-helpers",
    "test:e2e": "pnpm test:e2e:smoke && pnpm test:e2e:web && pnpm test:e2e:embed",
    "test:e2e:smoke": "node ../../scripts/run-playwright-with-preview.mjs test --project=smoke && node ../../scripts/run-playwright-with-preview.mjs test --project=firefox-smoke",
    "test:e2e:web": "node ../../scripts/run-playwright-with-preview.mjs test --project=e2e",
    "test:e2e:embed": "node ../../scripts/run-playwright-with-preview.mjs test --project=embed",
    "test:golden:web": "node ../../scripts/run-playwright-with-preview.mjs test --project=golden"
  },
  "dependencies": {
    "@bozonx/fastcat-embed": "workspace:*",
    "@fastcat/shared": "workspace:*",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "^10.5.0",
    "@pinia/nuxt": "^1.0.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@vueuse/core": "^14.3.0",
    "exifr": "^7.1.3",
    "js-yaml": "^5.2.1",
    "mediabunny": "^1.50.9",
    "nuxt": "^4.5.0",
    "p-queue": "^9.3.2",
    "pinia": "^4.0.2",
    "pixi.js": "^8.19.0",
    "splitpanes": "^4.1.2",
    "tauri-plugin-fs-stream-api": "2.0.3",
    "vue": "^3.5.40",
    "vue-draggable-plus": "^0.6.1",
    "wavesurfer.js": "^7.12.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fastcat/eslint-config": "workspace:*",
    "@fastcat/typescript-config": "workspace:*",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.118",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/icon": "^2.3.1",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/device": "^4.0.0",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/splitpanes": "^2.2.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.7.0",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~5.9.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-i18n": "^11.4.7",
    "vue-tsc": "^3.3.7"
  }
}
