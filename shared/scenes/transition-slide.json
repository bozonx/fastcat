{
  "_comment": [
    "Cross-engine parity scene: slide transition between two layers.",
    "Includes both web params and native spec so each engine picks the right representation.",
    "Mid-transition cross-fade is NOT validated here: the flat parity scene omits the transition `spec`/peer wiring that the real app always supplies, so the two engines take different shader-vs-alpha fallback paths (web shows the top clip fully, native alpha-fades). We sample t=0.1s (clip-a only) and t=0.5s (resolved to clip-b) \u2014 the points where both engines agree \u2014 as a render smoke check."
  ],
  "scene": {
    "width": 320,
    "height": 240,
    "layers": [
      {
        "id": "clip-a",
        "kind": "image",
        "path": "image/image.jpg",
        "timeline_start_sec": 0,
        "timeline_end_sec": 0.5,
        "source_start_sec": 0,
        "source_range_duration_sec": 0,
        "speed": 1,
        "z": 0,
        "opacity": 1,
        "blend_mode": "normal",
        "transition_out": {
          "type": "slide",
          "duration_sec": 0.3,
          "mode": "transparent",
          "curve": "linear",
          "params": {
            "direction": "left",
            "gap": 0.02,
            "gapColor": "#000000",
            "motionBlur": 0,
            "motionBlurMode": "normal",
            "brightnessMode": "normal",
            "brightness": 0,
            "bloomThreshold": 0.7
          },
          "spec": {
            "type": "slide",
            "direction": "left"
          }
        }
      },
      {
        "id": "clip-b",
        "kind": "background",
        "path": "",
        "timeline_start_sec": 0.2,
        "timeline_end_sec": 1,
        "source_start_sec": 0,
        "source_range_duration_sec": 0,
        "speed": 1,
        "z": 1,
        "opacity": 1,
        "blend_mode": "normal",
        "background_color": "#ff6600",
        "transition_in": {
          "type": "slide",
          "duration_sec": 0.3,
          "mode": "transparent",
          "curve": "linear",
          "params": {
            "direction": "left",
            "gap": 0.02,
            "gapColor": "#000000",
            "motionBlur": 0,
            "motionBlurMode": "normal",
            "brightnessMode": "normal",
            "brightness": 0,
            "bloomThreshold": 0.7
          },
          "spec": {
            "type": "slide",
            "direction": "left"
          }
        }
      }
    ],
    "video_tracks": [],
    "audio_layers": [],
    "audio_tracks": [],
    "audio_master_gain": 1,
    "audio_master_muted": false,
    "preview_fps": 30,
