{
  "_comment": [
    "Cross-engine parity fixture for the perceptual frame hash.",
    "Each case describes an RGBA frame procedurally (background fill + ordered",
    "rectangles). The web/TS hash (src/utils/video-editor/perceptual-hash.ts) and",
    "the native/Rust hash (src-tauri/tests/engine_parity.rs) both rebuild the",
    "frame and must reproduce expectedHash (64-bit luma aHash) and",
    "expectedColorSig (2x2 mean-color, 12 bytes). This locks the two independent",
    "implementations together so they can never silently drift.",
    "Regenerate with: tsx scripts/gen-frame-hash-fixture.ts"
  ],
  "cases": [
    {
      "name": "solid-white",
      "width": 8,
      "height": 8,
      "background": [
        255,
        255,
        255,
        255
      ],
      "rects": [],
      "expectedHash": "0000000000000000",
      "expectedColorSig": "ffffffffffffffffffffffff"
    },
    {
      "name": "solid-black",
      "width": 8,
      "height": 8,
      "background": [
        0,
        0,
        0,
        255
      ],
      "rects": [],
      "expectedHash": "0000000000000000",
      "expectedColorSig": "000000000000000000000000"
    },
    {
      "name": "solid-red",
      "width": 8,
      "height": 8,
      "background": [
        255,
        0,
        0,
        255
      ],
      "rects": [],
      "expectedHash": "ffffffffffffffff",
      "expectedColorSig": "ff0000ff0000ff0000ff0000"
    },
    {
      "name": "left-white-right-black",
      "width": 8,
      "height": 8,
      "background": [
        0,
        0,
        0,
        255
      ],
      "rects": [
        {
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 8,
          "color": [
            255,
            255,
            255,
            255
          ]
        }
      ],
      "expectedHash": "f0f0f0f0f0f0f0f0",
      "expectedColorSig": "ffffff000000ffffff000000"
    },
    {
      "name": "top-white-bottom-black",
      "width": 8,
      "height": 8,
      "background": [
        0,
        0,
        0,
        255
      ],
      "rects": [
        {
          "x": 0,
          "y": 0,
          "w": 8,
          "h": 4,
          "color": [
            255,
            255,
            255,
            255
          ]
        }
      ],
      "expectedHash": "ffffffff00000000",
      "expectedColorSig": "ffffffffffff000000000000"
    },
    {
      "name": "quadrants-rgbw",
      "width": 8,
      "height": 8,
      "background": [
        0,
        0,
        0,
        255
      ],
      "rects": [
        {
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 4,
          "color": [
            255,
            0,
            0,
            255
          ]
        },
        {
          "x": 4,
          "y": 0,
          "w": 4,
          "h": 4,
          "color": [
            0,
            255,
            0,
            255
          ]
        },
        {
          "x": 0,
          "y": 4,
          "w": 4,
          "h": 4,
          "color": [
            0,
            0,
            255,
            255
          ]
        },
        {
          "x": 4,
          "y": 4,
          "w": 4,
          "h": 4,
          "color": [
            255,
            255,
            255,
            255
          ]
        }
      ],
      "expectedHash": "0f0f0f0f0f0f0f0f",
      "expectedColorSig": "ff000000ff000000ffffffff"
    },
    {
      "name": "quadrants-bgrw",
      "width": 8,
      "height": 8,
      "background": [
        0,
        0,
        0,
        255
      ],
      "rects": [
        {
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 4,
          "color": [
            0,
            0,
            255,
            255
          ]
        },
        {
          "x": 4,
          "y": 0,
          "w": 4,
          "h": 4,
          "color": [
            0,
            255,
            0,
            255
          ]
        },
        {
          "x": 0,
          "y": 4,
          "w": 4,
          "h": 4,
          "color": [
            255,
            0,
            0,
            255
          ]
        },
        {
          "x": 4,
          "y": 4,
          "w": 4,
          "h": 4,
          "color": [
            255,
            255,
            255,
            255
          ]
        }
      ],
      "expectedHash": "0f0f0f0f0f0f0f0f",
      "expectedColorSig": "0000ff00ff00ff0000ffffff"
    },
    {
      "name": "gray-center-square",
      "width": 16,
      "height": 16,
      "background": [
        128,
        128,
        128,
        255
      ],
      "rects": [
        {
          "x": 4,
          "y": 4,
          "w": 8,
          "h": 8,
          "color": [
            255,
            255,
            255,
            255
          ]
        }
      ],
      "expectedHash": "00003c3c3c3c0000",
      "expectedColorSig": "a0a0a0a0a0a0a0a0a0a0a0a0"
    }
  ]
}
