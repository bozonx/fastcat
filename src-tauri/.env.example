# FastCat — Tauri environment variables
#
# Copy this file to `.env` and adjust as needed.
# These variables are read by both the Rust backend (at runtime) and the
# Nuxt frontend (at build/dev time via beforeDevCommand / beforeBuildCommand).
# All variables are optional; the app runs fine without any of them.

# ---------------------------------------------------------------------------
# Feature flags (read by nuxt.config.ts → runtimeConfig)
# ---------------------------------------------------------------------------
# Enables functionality that is still in development. Default: false.
FASTCAT_ENABLE_IN_DEVELOPMENT_FEATURES=false

# Enables all premium functionality. Default: false.
FASTCAT_ENABLE_PREMIUM_FEATURES=false

# ---------------------------------------------------------------------------
# Render telemetry (read by Rust: src/compositor/render_telemetry.rs)
# ---------------------------------------------------------------------------
# Set to "1" to enable per-frame render-stage timing logs
# (materialize / vello-build / render). Any value other than "0" enables it.
# Default: disabled
FASTCAT_RENDER_TIMING=0

# ---------------------------------------------------------------------------
# Dev directory (read by nuxt.config.ts)
# ---------------------------------------------------------------------------
# Directory for app config files (only used in dev mode).
FASTCAT_DEV_DIR=./.dev-files

# ---------------------------------------------------------------------------
# External API URLs (read by nuxt.config.ts → runtimeConfig.public)
# ---------------------------------------------------------------------------
# BloggerDog instance base URL
NUXT_PUBLIC_BLOGGER_DOG_API_URL=https://api.bloggerdog.pro
NUXT_PUBLIC_BLOGGER_DOG_UI_URL=https://bloggerdog.pro
# FastCat Account base URL
NUXT_PUBLIC_FASTCAT_ACCOUNT_API_URL=https://user-account.fastcat.video
NUXT_PUBLIC_FASTCAT_ACCOUNT_UI_URL=https://user-account.fastcat.video/ui

# ---------------------------------------------------------------------------
# UI behaviour (read by nuxt.config.ts → runtimeConfig.public)
# ---------------------------------------------------------------------------
# Controls whether the browser's native context menu (right-click) is blocked.
# Set to "false" to allow the system context menu.
# Default: true
NUXT_PUBLIC_BLOCK_CONTEXT_MENU=true

# ---------------------------------------------------------------------------
# Dev server port (read by nuxt.config.ts → devServer)
# ---------------------------------------------------------------------------
# Must match the devUrl port in tauri.conf.json
PORT=3009

# ---------------------------------------------------------------------------
# Audio decode offline probe (Rust #[ignore]d test only)
# ---------------------------------------------------------------------------
# Used by `decode_streaming_offline_probe` — an #[ignore]d test that decodes
# a real media file in streaming mode and writes a WAV for manual inspection.
#
# Absolute path to the media file to probe.
# FASTCAT_PROBE_FILE=/abs/path/to/media.wav
#
# Target sample rate for the probe. Default: 44100
# FASTCAT_PROBE_RATE=44100
#
# Duration in seconds to decode. Default: 5.0
# FASTCAT_PROBE_SECS=5.0
