{
  "name": "@bozonx/fastcat-embed",
  "version": "0.2.2",
  "description": "SDK for embedding the FastCat video editor into any web page through an isolated iframe.",
  "license": "MIT",
  "type": "module",
  "author": "FastCat Team",
  "homepage": "https://github.com/bozonx/fastcat#readme",
  "bugs": {
    "url": "https://github.com/bozonx/fastcat/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bozonx/fastcat.git",
    "directory": "packages/embed"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "validate": "pnpm check",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@fastcat/eslint-config": "workspace:*",
    "@fastcat/typescript-config": "workspace:*",
    "eslint": "^10.7.0",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "fastcat",
    "video-editor",
    "embed",
    "iframe",
    "sdk",
    "postmessage",
    "webgpu"
  ],
  "sideEffects": false
}
